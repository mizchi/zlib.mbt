diff --git 1/compress/gzip/frame_wbtest.mbt 2/compress/gzip/frame_wbtest.mbt
new file mode 100644
index 00000000..bc768fb4
--- /dev/null
+++ 2/compress/gzip/frame_wbtest.mbt
@@ -0,0 +1,46 @@
+///|
+test "frame preserves complete stored streams at allocation boundaries" {
+  for size in [0, 1, 15, 16, 63, 64, 65, 1024, 65535, 65536, 262144] {
+    let backing = Bytes::from_array(
+      FixedArray::makei(size + 7, i => (i % 251).to_byte()),
+    )
+    let input = backing[3:3 + size]
+    let deflated = @flate.deflate_all(input, strategy=Standard(level=0))
+    let framed = gzip_frame(input, deflated)
+    @test.assert_eq(decompress(framed), input.to_owned())
+    @test.assert_eq(framed.length(), deflated.length() + 18)
+    if size == 262144 {
+      // Golden trailer from Python zlib, independent of the decoder/checksum code.
+      @test.assert_eq(
+        framed[framed.length() - 8:].to_owned(),
+        b"\x3c\x9e\x2f\x54\x00\x00\x04\x00",
+      )
+    }
+  }
+}
+
+///|
+test "bench complete frame allocation" (b : @bench.T) {
+  for size in [1024, 262144] {
+    let input = Bytes::from_array(
+      FixedArray::makei(size, i => (i % 251).to_byte()),
+    )
+    let deflated = @flate.deflate_all(input, strategy=Standard(level=0))
+    let sink : FixedArray[Int32] = [0]
+    b.bench(name="gzip frame \{size}", count=7, () => {
+      sink[0] = gzip_frame(input, deflated).length()
+    })
+  }
+}
+
+///|
+test "bench complete stored compression" (b : @bench.T) {
+  let input = Bytes::makei(262144, i => (i % 251).to_byte())
+  let sink : FixedArray[Int32] = [0]
+  b.bench(name="gzip compress level 0 262144", count=7, () => {
+    sink[0] = compress(input, strategy=Standard(level=0)).length()
+  })
+  b.bench(name="gzip compress level 6 262144", count=7, () => {
+    sink[0] = compress(input, strategy=Standard(level=6)).length()
+  })
+}
diff --git 1/compress/zlib/frame_wbtest.mbt 2/compress/zlib/frame_wbtest.mbt
new file mode 100644
index 00000000..4e4b31da
--- /dev/null
+++ 2/compress/zlib/frame_wbtest.mbt
@@ -0,0 +1,57 @@
+///|
+test "frame preserves complete stored streams at allocation boundaries" {
+  for size in [0, 1, 15, 16, 63, 64, 65, 1024, 65535, 65536, 262144] {
+    let backing = Bytes::from_array(
+      FixedArray::makei(size + 7, i => (i % 251).to_byte()),
+    )
+    let input = backing[3:3 + size]
+    let deflated = @flate.deflate_all(input, strategy=Standard(level=0))
+    let framed = zlib_frame(input, deflated, None)
+    @test.assert_eq(decompress(framed), input.to_owned())
+    @test.assert_eq(framed.length(), deflated.length() + 6)
+    if size == 262144 {
+      // Golden trailer from Python zlib, independent of the decoder/checksum code.
+      @test.assert_eq(
+        framed[framed.length() - 4:].to_owned(),
+        b"\x9c\x41\x00\xfb",
+      )
+    }
+  }
+}
+
+///|
+test "bench complete frame allocation" (b : @bench.T) {
+  for size in [1024, 262144] {
+    let input = Bytes::from_array(
+      FixedArray::makei(size, i => (i % 251).to_byte()),
+    )
+    let deflated = @flate.deflate_all(input, strategy=Standard(level=0))
+    let sink : FixedArray[Int32] = [0]
+    b.bench(name="zlib frame \{size}", count=7, () => {
+      sink[0] = zlib_frame(input, deflated, None).length()
+    })
+  }
+}
+
+///|
+test "frame preserves preset dictionary id" {
+  let dict = b"MoonBit dictionary"
+  let input = b"MoonBit dictionary with repeated MoonBit dictionary"
+  let deflated = @flate.deflate_all(input, dictionary=dict)
+  let framed = zlib_frame(input, deflated, Some(dict))
+  @test.assert_eq(framed.length(), deflated.length() + 10)
+  @test.assert_eq(decompress(framed, dictionary=dict), input)
+  @test.assert_eq(framed, compress(input, dictionary=dict))
+}
+
+///|
+test "bench complete stored compression" (b : @bench.T) {
+  let input = Bytes::makei(262144, i => (i % 251).to_byte())
+  let sink : FixedArray[Int32] = [0]
+  b.bench(name="zlib compress level 0 262144", count=7, () => {
+    sink[0] = compress(input, strategy=Standard(level=0)).length()
+  })
+  b.bench(name="zlib compress level 6 262144", count=7, () => {
+    sink[0] = compress(input, strategy=Standard(level=6)).length()
+  })
+}
