 ///|
 /// Wrap a raw DEFLATE stream `deflated` of `input` in the zlib header/trailer.
+#cfg(any(target="native", target="wasm"))
+fn zlib_frame(
+  input : BytesView,
+  deflated : Bytes,
+  dictionary : BytesView?,
+) -> Bytes {
+  let header = zlib_header(dictionary)
+  guard! deflated.length() <= 0x7FFFFFFF - header.length() - 4
+  let payload_end = header.length() + deflated.length()
+  // Fill the final allocation directly. In addition to avoiding growth, the
+  // whole, exclusively owned array can become Bytes without a copy on native/Wasm.
+  let out = FixedArray::make(payload_end + 4, b'\x00')
+  for i, byte in header {
+    out[i] = byte
+  }
+  out.blit_from_bytes(header.length(), deflated, 0, deflated.length())
+  let adler = @checksum.adler32(input)
+  for i in 0..<4 {
+    out[payload_end + i] = ((adler >> (24 - i * 8)) & 0xFF).to_byte()
+  }
+  Bytes::from_array(out)
+}
