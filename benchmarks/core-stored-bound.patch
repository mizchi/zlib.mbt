From 3bdbd9443fd7370a225bf93df6d965d3b7fd6d66 Mon Sep 17 00:00:00 2001
From: mizchi <miz404@gmail.com>
Date: Fri, 13 Nov 2026 21:12:59 +0900
Subject: [PATCH] perf(compress/flate): return exact stored output bounds

---
 compress/flate/deflate_all.mbt         | 10 ++++
 compress/flate/moon.pkg                |  1 +
 compress/flate/stored_bound_wbtest.mbt | 77 ++++++++++++++++++++++++++
 3 files changed, 88 insertions(+)
 create mode 100644 compress/flate/stored_bound_wbtest.mbt

diff --git a/compress/flate/deflate_all.mbt b/compress/flate/deflate_all.mbt
index 855c6bf8..deafea5c 100644
--- a/compress/flate/deflate_all.mbt
+++ b/compress/flate/deflate_all.mbt
@@ -89,12 +89,22 @@ pub fn Compressor::Compressor(
 ///|
 /// An output capacity sufficient for the selected strategy, with or without
 /// `fast_store`. Panics for negative input sizes or an unrepresentable bound.
+/// Standard and Split return the exact stored size at level 0.
 pub fn deflate_bound(
   input_size : Int32,
   strategy~ : Strategy = Standard(level=6),
 ) -> Int32 {
   guard input_size >= 0 else { abort("negative DEFLATE input size") }
   let size = input_size.to_int64()
+  if strategy is Standard(level=0) || strategy is Split(level=0) {
+    // A stored block has a five-byte header and holds at most 65535 bytes.
+    // Even an empty input emits one block. No tokenization or splitting is used.
+    let bound = size + 5L * ((size + 65534L) / 65535L).max(1L)
+    guard bound <= 0x7fff_ffffL else {
+      abort("DEFLATE output capacity overflow")
+    }
+    return bound.to_int()
+  }
   // Every planned block costs at most its stored encoding, plus one byte
   // for alignment. Stored segments may themselves split at 65535 bytes.
   // Split has at most seven parts per chunk (including match overhang);
diff --git a/compress/flate/moon.pkg b/compress/flate/moon.pkg
index c7ea00aa..72a7024f 100644
--- a/compress/flate/moon.pkg
+++ b/compress/flate/moon.pkg
@@ -15,6 +15,7 @@ import {
 
 import {
   "moonbitlang/core/test",
+  "moonbitlang/core/bench",
 } for "wbtest"
 
 // v128 is experimental; its import is used only by native/linear-wasm paths.
diff --git a/compress/flate/stored_bound_wbtest.mbt b/compress/flate/stored_bound_wbtest.mbt
new file mode 100644
index 00000000..5017ddf5
--- /dev/null
+++ b/compress/flate/stored_bound_wbtest.mbt
@@ -0,0 +1,77 @@
+// Copyright 2026 International Digital Economy Academy
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
