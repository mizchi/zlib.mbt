--- i/compress/gzip/gzip.mbt
+++ w/compress/gzip/gzip.mbt
@@ -122,9 +122,29 @@ fn u32_le(data : BytesView, off : Int32) -> UInt32 {
 
 ///|
 /// Wrap a raw DEFLATE stream `deflated` of `input` in the gzip header/trailer.
+#cfg(any(target="native", target="wasm"))
+fn gzip_frame(input : BytesView, deflated : Bytes) -> Bytes {
+  guard! deflated.length() <= 0x7FFFFFFF - 18
+  let payload_end = 10 + deflated.length()
+  // Fill the final allocation, including both framing fields, without growing
+  // a Buffer or retaining an alias when the array is converted to Bytes.
+  let out = FixedArray::make(payload_end + 8, b'\x00')
+  // Header: magic, CM=8 (deflate), FLG=0, MTIME=0, XFL=0, OS=255 (unknown).
+  out.blit_from_bytes(0, b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff", 0, 10)
+  out.blit_from_bytes(10, deflated, 0, deflated.length())
+  let crc = @checksum.crc32(input)
+  let size = input.length().reinterpret_as_uint()
+  for i in 0..<4 {
+    out[payload_end + i] = ((crc >> (i * 8)) & 0xFF).to_byte()
+    out[payload_end + 4 + i] = ((size >> (i * 8)) & 0xFF).to_byte()
+  }
+  Bytes::from_array(out)
+}
